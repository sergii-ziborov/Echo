        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предметы можно собирать"
          }
        }
      }
    },
    "ability.phase.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PHASE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ФАЗА"
          }
        }
      }
    },
