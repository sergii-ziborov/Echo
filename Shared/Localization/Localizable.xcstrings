    "level.35.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three beams, three beats, one route through."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три луча, три такта, один путь."
          }
        }
      }
    },
    "level.35.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Array"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фазовый массив"
          }
        }
      }
    },
    "level.36.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The firing core divides its working space into sectors. Return with their records."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Излучающее ядро делит рабочую область на сектора. Вернись с их записями."
          }
        }
      }
    },
    "level.36.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the four sectors, then cross the firing core."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери все четыре сектора, затем пересеки излучающее ядро."
          }
        }
      }
    },
    "level.36.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Firing Core"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Излучающее ядро"
          }
        }
      }
    },
    "level.37.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The corona station watched Ashcrown. Its warning lights still precede its own beams."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Станция короны наблюдала Эшкраун. Её сигнальные огни всё ещё предшествуют лучам установки."
          }
        }
      }
    },
    "level.37.place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Corona"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корона"
          }
        }
      }
    },
    "level.37.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the light before it fires."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитай свет, пока он не выстрелил."
          }
        }
      }
    },
    "level.37.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corona"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корона"
          }
        }
      }
    },
    "level.38.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The station's old warning sequence still works. Let its light reveal the next opening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая последовательность предупреждений ещё работает. Пусть её свет покажет следующее окно."
          }
        }
      }
    },
    "level.38.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two safe lanes are never safe at the same time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два безопасных прохода никогда не безопасны одновременно."
          }
        }
      }
    },
    "level.38.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twinfire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойной огонь"
          }
        }
      }
    },
    "level.39.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The redshift post holds Ashcrown's last spectrum. In that record, the star still shines."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пост красного смещения хранит последний спектр Эшкрауна. На этой записи звезда ещё светит."
          }
        }
      }
    },
    "level.39.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the warning light; the beams keep their own rhythm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следи за предупреждением: у лучей свой ритм."
          }
        }
      }
    },
    "level.39.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redshift"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Красное смещение"
          }
        }
      }
    },
    "level.4.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old holding channel still answers here. Its help lasts only briefly."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старый канал удержания ещё отвечает. Его помощь длится недолго."
          }
        }
      }
    },
    "level.4.place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirror Hall"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зеркальный зал"
          }
        }
      }
    },
    "level.4.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four copies. No empty air."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре копии. Пустого места нет."
          }
        }
      }
    },
    "level.4.title": {
