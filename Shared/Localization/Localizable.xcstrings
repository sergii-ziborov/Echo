      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best for learning dense maps without losing a run to one mistake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы учить плотные карты, не теряя попытку из-за одной ошибки."
          }
        }
      }
    },
    "upgrade.aegis.effect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extends protection after a shield hit; its final rank adds starting protection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продлевает защиту после удара по щиту; последний ранг добавляет стартовую защиту."
