            "state": "translated",
            "value": "ROCKS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КАМНИ"
          }
        }
      }
    },
    "region.gravity.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GRAVITY"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТЯГОТЕНИЕ"
          }
        }
      }
    },
    "region.gravity.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ashcrown's compact remnant hangs beyond the stations. On the arena, damaged field wells pull the Signal toward lethal cores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "За станциями виден компактный остаток Эшкрауна. На арене повреждённые полевые ловушки тянут Сигнал к опасным ядрам."
          }
        }
      }
    },
    "region.gravity.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field wells near Ashcrown's compact remnant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полевые ловушки у остатка Эшкрауна."
          }
        }
      }
    },
    "region.gravity.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An undertow is a current you cannot see from the edge. The operators gave that name to the damaged transport fields near Ashcrown's remnant."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратное течение — поток, которого не видно с края. Так операторы назвали повреждённые транспортные поля у остатка Эшкрауна."
          }
        }
      }
    },
    "region.gravity.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Undertow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратное течение"
          }
        }
      }
    },
    "region.gravity.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One compact remnant does not become a flock of black holes. The field wells in the arena are game fields with a limited reach."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один компактный остаток не превращается в стаю чёрных дыр. Полевые ловушки на арене — игровые поля с ограниченным радиусом."
          }
        }
      }
    },
    "region.gravity.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PULL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТЯГА"
          }
        }
      }
    },
    "region.gravity.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ORBITS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ОРБИТЫ"
          }
        }
      }
    },
    "region.gravity.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LETHAL CORE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЯДРО"
          }
        }
      }
    },
    "region.mirage.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MIRAGE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "МИРАЖ"
          }
        }
      }
    },
    "region.mirage.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several images do not always mean several worlds. Here, a misleading view and a damaged transfer frame are different dangers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько изображений не всегда означают несколько миров. Здесь обманчивый вид и повреждённая привязка перехода — разные опасности."
          }
        }
      }
    },
    "region.mirage.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where image, record and object disagree."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где образ, запись и объект не совпадают."
          }
        }
      }
    },
    "region.mirage.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass is the operators' nickname for repeated, distorted images; the nebula is the visible cloud of gas and dust. Mirage sets image, record and object against each other."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стекло — прозвище многократных искажённых изображений; туманность — видимое облако газа и пыли. Мираж противопоставляет образ, запись и объект."
          }
        }
      }
    },
    "region.mirage.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass Nebula"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стеклянная туманность"
          }
        }
      }
    },
    "region.mirage.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravitational lensing bends the paths of light, not the commands of your hand. Flipped steering comes from a transfer, not from the view."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гравитационное линзирование искривляет пути света, а не команды руки. Инверсия управления возникает от перехода, а не от вида."
          }
        }
      }
    },
    "region.mirage.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MIRROR"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗЕРКАЛО"
          }
        }
      }
    },
    "region.mirage.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PHASE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ФАЗА"
          }
        }
      }
    },
    "region.mirage.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FALSE ROUTES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЛОЖНЫЕ ПУТИ"
          }
        }
      }
    },
    "region.paradox.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PARADOX"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПАРАДОКС"
          }
        }
      }
    },
    "region.paradox.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keepers tested their recovery systems here. The tests still repeat; the people who judged them do not answer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь Хранители испытывали системы восстановления. Испытания повторяются; те, кто оценивал их, больше не отвечают."
          }
        }
      }
    },
    "region.paradox.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test chambers still running their old trials."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Испытательные камеры повторяют старые тесты."
          }
        }
      }
    },
    "region.paradox.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keepers proved their devices here by testing them. The paradox: accept change, yet always return to the confirmed state."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь Хранители доказывали работоспособность устройств испытаниями. Парадокс: принимать изменения — и всегда возвращать подтверждённое состояние."
          }
        }
      }
    },
    "region.paradox.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proving Grounds"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Испытательные полигоны"
          }
        }
      }
    },
    "region.paradox.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pulsar is a living, spinning stellar remnant — not a dead star that mysteriously keeps ticking."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пульсар — действующий вращающийся остаток звезды, а не мёртвый объект, мистически продолжающий тикать."
          }
        }
      }
    },
    "region.paradox.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BEAMS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЛУЧИ"
          }
        }
      }
    },
    "region.paradox.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GATES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ШЛЮЗЫ"
          }
        }
      }
    },
    "region.paradox.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FREEZE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "УДЕРЖАНИЕ"
          }
        }
      }
    },
    "region.rift.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RIFT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАЗРЫВ"
          }
        }
      }
    },
    "region.rift.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Road's damaged connections still accept the Signal. The exit address and control orientation may no longer match the entrance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повреждённые соединения Дороги всё ещё принимают Сигнал. Адрес выхода и ориентация управления больше не обязаны соответствовать входу."
          }
        }
      }
    },
    "region.rift.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Damaged links that move the Signal elsewhere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повреждённые соединения уводят Сигнал в сторону."
          }
        }
      }
    },
    "region.rift.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rift is where a channel's entrance and exit no longer agree. The Riftlands are the damaged nodes of one branch, not a lawless dimension."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрыв — место, где вход и выход канала больше не согласованы. Область разрывов — повреждённые узлы одной ветви, а не измерение без правил."
          }
        }
      }
    },
    "region.rift.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Riftlands"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Область разрывов"
          }
        }
      }
    },
    "region.rift.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer moves the Signal, shifts the replay clock and flips steering for a while. It is not a full rewind or travel into the past."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход переносит Сигнал, сдвигает часы повтора и на время инвертирует управление. Это не полный откат и не путешествие в прошлое."
          }
        }
      }
    },
    "region.rift.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRANSFER"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПЕРЕНОС"
          }
        }
      }
    },
    "region.rift.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FOLDS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СКЛАДКИ"
          }
        }
      }
    },
    "region.rift.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "COMETS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КОМЕТЫ"
          }
        }
      }
    },
    "region.singularity.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SINGULARITY"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СИНГУЛЯРНОСТЬ"
          }
        }
      }
    },
    "region.singularity.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Road passes observation stations around dying Ashcrown. Their last stable readings have become commands they cannot stop obeying."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дорога проходит через станции наблюдения умирающего Эшкрауна. Последние устойчивые показания стали командами, которым станции не могут перестать подчиняться."
          }
        }
      }
    },
    "region.singularity.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observation stations around a dying star."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Станции наблюдения у умирающей звезды."
          }
        }
      }
    },
    "region.singularity.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ashcrown was named for the ash-grey rim in the station's images; the corona is its outer glow. Singularity is where the old model stops working."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эшкраун назвали за пепельный обод на снимках станции; корона — его внешнее свечение. Сингулярность — режим, где прежняя модель перестаёт работать."
          }
        }
      }
    },
    "region.singularity.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ashcrown Corona"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Корона Эшкрауна"
          }
        }
      }
    },
    "region.singularity.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A singularity is not an observed ball of infinite density, and the game does not simulate a stellar collapse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сингулярность — не наблюдаемый шарик бесконечной плотности, и игра не моделирует коллапс звезды."
          }
        }
      }
    },
    "region.singularity.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FLARES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВСПЫШКИ"
          }
        }
      }
    },
    "region.singularity.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIXED CORE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЯДРО"
          }
        }
      }
    },
    "region.singularity.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EVERY HAZARD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВСЁ СРАЗУ"
          }
        }
      }
    },
    "region.trace.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRACE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СЛЕД"
          }
        }
      }
    },
    "region.trace.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse is dark, but its channels still record movement. Gather the state records and reopen the first route."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маяк погас, но его каналы продолжают записывать движение. Собери опорные записи и открой первую линию."
          }
        }
      }
    },
    "region.trace.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference station where the Signal was lit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опорная станция, где зажгли Сигнал."
          }
        }
      }
    },
    "region.trace.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The station is named for its job: sending a reference signal. Trace is the first recorded path of the Signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Станция названа по назначению: она выдаёт опорный сигнал. След — первая записанная траектория Сигнала."
          }
        }
      }
    },
    "region.trace.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маяк"
          }
        }
      }
    },
    "region.trace.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network time is an agreement between clocks. The Lighthouse never held one time for the whole universe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время сети — соглашение между часами. Маяк никогда не держал единое время всей Вселенной."
          }
        }
      }
    },
    "region.trace.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHOES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЭХО"
          }
        }
      }
    },
    "region.trace.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TIMED CRYSTALS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КРИСТАЛЛЫ"
          }
