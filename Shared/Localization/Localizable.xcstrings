          }
        }
      }
    },
    "level.40.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old mount holds the lens array in place. Fragments continue to circle it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старое крепление удерживает массив линз. Вокруг него продолжают ходить обломки."
          }
        }
      }
    },
    "level.40.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed core; three shards circle it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённое ядро и три кружащих осколка."
          }
        }
      }
    },
    "level.40.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lens Array"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Массив линз"
          }
        }
      }
    },
    "level.41.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pulse station surrounds an old reference point. Cross when its emitters leave room."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импульсная станция окружает старую опорную точку. Пересекай её, когда излучатели оставляют место."
          }
        }
      }
    },
    "level.41.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the gap in the rhythm near the centre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найди разрыв в ритме у самого центра."
          }
        }
      }
    },
    "level.41.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse Crown"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Венец импульсов"
          }
        }
      }
    },
    "level.42.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Hour marked the start of emergency holding, not the disappearance of time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нулевой час отмечал запуск аварийного удержания, а не исчезновение времени."
          }
        }
      }
    },
    "level.42.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every hazard of the corona at once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все опасности короны разом."
          }
        }
      }
    },
    "level.42.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero Hour"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нулевой час"
          }
        }
      }
    },
    "level.43.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first damaged connection transfers the Signal to another address in the cell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое повреждённое соединение переносит Сигнал к другому адресу ячейки."
          }
        }
      }
    },
    "level.43.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first door opens somewhere else."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая дверь открывается в другом месте."
          }
        }
      }
    },
    "level.43.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First Tear"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый разрыв"
          }
        }
      }
    },
    "level.44.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fold joins two addresses. Plan where the carrier will appear before entering."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Складка соединяет два адреса. Спланируй место появления носителя до входа."
          }
        }
      }
    },
    "level.44.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross once; return on a different axis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейди один раз — вернёшься по другой оси."
          }
        }
      }
    },
    "level.44.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foldline"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия складки"
          }
        }
      }
    },
    "level.45.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cell survived on both sides of a damaged connection. Find the route that joins them again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ячейка уцелела по обе стороны повреждённого соединения. Найди путь, который снова их свяжет."
          }
        }
      }
    },
    "level.45.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One cell, two sides of a damaged link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна ячейка, две стороны повреждённого соединения."
          }
        }
      }
    },
    "level.45.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split Channel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделённый канал"
          }
        }
      }
    },
    "level.46.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The breach knocks replay out of step. The old route remains, but returns at a different moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрыв сбивает ритм воспроизведения. Прежний путь остаётся, но вернётся в другой момент."
          }
        }
      }
    },
    "level.46.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tear shifts the replay: old routes return at a different moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрыв сдвигает повтор: старые пути вернутся в другой момент."
          }
        }
      }
    },
    "level.46.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backstep"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг назад"
          }
        }
      }
    },
    "level.47.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door's position stays fixed; the connection opens on its own schedule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положение двери неизменно; соединение открывается по собственному расписанию."
          }
        }
      }
    },
    "level.47.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door stays put; it opens on its own schedule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дверь на месте — она открывается по своему расписанию."
          }
        }
      }
    },
    "level.47.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False Door"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложная дверь"
          }
        }
      }
    },
    "level.48.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After transfer, the control frame is inverted horizontally. The walls remain where they were."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перехода управление инвертируется по горизонтали. Стены остаются на месте."
          }
        }
      }
    },
    "level.48.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a transfer, left and right swap for a while."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перехода лево и право на время меняются местами."
          }
        }
      }
    },
    "level.48.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broken Axis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сломанная ось"
          }
        }
      }
    },
    "level.49.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The central breach is still a passage, but a passage is not automatically a rescue."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центральный разрыв остаётся проходом. Но проход не обязательно означает спасение."
          }
        }
      }
    },
    "level.49.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the breach before it uses you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используй разрыв, пока он не использовал тебя."
          }
        }
      }
    },
    "level.49.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rift Heart"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сердце разрыва"
          }
        }
      }
    },
    "level.5.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The orrery carries its beacons around prepared tracks. They do not wait for the Signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оррерий ведёт опорные носители по заданным кругам. Они не ждут Сигнал."
          }
        }
      }
    },
    "level.5.place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Orrery"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оррерий"
          }
        }
      }
    },
    "level.5.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks refuse to sit still."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искры не стоят на месте."
          }
        }
      }
    },
    "level.5.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Орбита"
          }
        }
      }
    },
    "level.50.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first field well pulls before its core destroys the carrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первая полевая ловушка тянет носитель раньше, чем её ядро его разрушает."
          }
        }
      }
    },
    "level.50.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The field well pulls long before its core kills."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ловушка тянет задолго до того, как убивает её ядро."
          }
        }
      }
    },
    "level.50.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark Tide"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмный прилив"
          }
        }
      }
    },
    "level.51.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wide approach gives room to correct the pull. It does not make the core safe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкий заход оставляет место для коррекции тяги. Ядро от этого не становится безопасным."
          }
        }
      }
    },
    "level.51.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit wide, then cut across the pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заходи широко, потом режь поперёк тяги."
          }
        }
      }
    },
    "level.51.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit Fall"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Падение с орбиты"
          }
        }
      }
    },
    "level.52.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The well draws inward while fragments cross the chamber. The Keepers called their overlapping motions a choir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ловушка тянет к центру, пока обломки пересекают камеру. Хранители называли наложение этих движений хором."
          }
        }
      }
    },
    "level.52.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three moving bodies around one field well."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три движущихся тела вокруг одной ловушки."
          }
        }
      }
    },
    "level.52.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravity Choir"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хор тяготения"
          }
        }
      }
    },
    "level.53.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A direct command does not guarantee a straight path through a pulling field."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая команда не гарантирует прямой путь в притягивающем поле."
          }
        }
      }
    },
    "level.53.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your straightest route will bend."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый прямой путь изогнётся."
          }
        }
      }
    },
    "level.53.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bent Route"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изогнутый маршрут"
          }
        }
      }
    },
    "level.54.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "State records lie near the field's edge. Collect the record without losing the carrier."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опорные записи лежат возле границы поля. Собери запись, не потеряв носитель."
          }
        }
      }
    },
    "level.54.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect at the edge of the pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирай на краю тяги."
          }
        }
      }
    },
    "level.54.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well Spring"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник у воронки"
          }
        }
      }
    },
    "level.55.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crossing combines a beam schedule with a pulling field. Neither waits for the other."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На переправе сочетаются расписание луча и поле тяги. Одно не ждёт другого."
          }
        }
      }
    },
    "level.55.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time the beam and the pull; neither waits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рассчитай луч и тягу: ни то, ни другое не ждёт."
          }
        }
      }
    },
    "level.55.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tide Crossing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переправа через течение"
          }
        }
      }
    },
    "level.56.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the dark star, an old station still keeps its exit ready. Find the path around the pull."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед тёмной звездой старая станция ещё держит выход. Найди путь в обход тяги."
          }
        }
      }
    },
    "level.56.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan your loop around the pull before you commit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спланируй петлю вокруг тяги заранее."
          }
        }
      }
    },
    "level.56.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark Star"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмная звезда"
          }
        }
      }
    },
    "level.57.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The glass returns two images of one distant world. Navigate by what stands in your path."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стекло возвращает два образа одного далёкого мира. Прокладывай путь по тому, что находится перед тобой."
          }
        }
      }
    },
    "level.57.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two images, one world. Steer by what is in front of you."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два образа, один мир. Веди по тому, что перед тобой."
          }
        }
      }
    },
    "level.57.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelglass"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойное отражение"
          }
        }
      }
    },
    "level.58.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer changes horizontal control for a short interval. Read the active status indicator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход ненадолго меняет горизонтальное управление. Следи за индикатором действующего эффекта."
          }
        }
      }
    },
    "level.58.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a transfer, horizontal control flips for a few seconds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перехода горизонтальное управление на несколько секунд меняется."
          }
        }
      }
    },
    "level.58.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inversion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инверсия"
          }
        }
      }
    },
    "level.59.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False North names a failed orientation reference. Trust the current route and visible targets."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложный север — отказавший ориентир. Доверяй текущему маршруту и видимым целям."
          }
        }
      }
    },
    "level.59.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trust the crystal, not the compass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верь кристаллу, а не компасу."
          }
        }
      }
    },
    "level.59.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "False North"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ложный север"
          }
        }
      }
    },
    "level.6.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flooded well resists movement. Leave yourself a route around its centre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затопленный колодец мешает движению. Оставь себе путь в обход центра."
          }
        }
      }
    },
    "level.6.place": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flooded Well"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затопленный колодец"
          }
        }
      }
    },
    "level.6.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The middle of the arena steals your speed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центр арены отнимает скорость."
          }
        }
      }
    },
    "level.6.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Топь"
          }
        }
      }
    },
    "level.60.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase changes contact with hazards. It does not remove the garden's solid walls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фаза меняет контакт с опасностями. Она не убирает твёрдые стены сада."
          }
        }
      }
    },
    "level.60.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase takes you past hazards — never through walls."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фаза проводит мимо опасностей, но не сквозь стены."
          }
        }
      }
    },
    "level.60.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase Garden"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фазовый сад"
          }
        }
      }
    },
    "level.61.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed core wears a moving mask of fragments. The core itself does not move aside."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподвижное ядро скрывается за движущейся маской обломков. Само оно с пути не уйдёт."
          }
        }
      }
    },
    "level.61.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three fragments circle one fixed core."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три обломка кружат вокруг одного закреплённого ядра."
          }
        }
      }
    },
    "level.61.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Echo Mask"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маска эха"
          }
        }
      }
    },
    "level.62.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The walls are honest. The connection beyond them has forgotten which way you came."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стены не лгут. Соединение за ними забыло, откуда пришёл Сигнал."
          }
        }
      }
    },
    "level.62.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The walls are honest; the breach is not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стены честны; разрыв — нет."
          }
        }
      }
    },
    "level.62.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glass Labyrinth"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стеклянный лабиринт"
          }
        }
      }
    },
    "level.63.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dream is an old name for a distorted view. Find the working connection beyond it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сон — старое имя искажённого вида. Найди за ним работающее соединение."
          }
        }
      }
    },
    "level.63.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake before the mirrored world closes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проснись, пока зеркальный мир не закрылся."
          }
        }
      }
    },
    "level.63.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dream Collapse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распад сна"
          }
        }
      }
    },
    "level.64.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bright training profile has lost its safety limits, not its old name."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркий учебный профиль потерял ограничения безопасности, но не прежнее имя."
          }
        }
      }
    },
    "level.64.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The candy profile runs faster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарный профиль работает быстрее."
          }
        }
      }
    },
    "level.64.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugar Static"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарный шум"
          }
        }
      }
    },
    "level.65.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sweets mark the old lesson's orbit. Its returning paths can still collide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сладости отмечают орбиту старого урока. Возвращающиеся пути всё ещё могут столкнуться."
          }
        }
      }
    },
    "level.65.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Circle the gumdrops; stay off your old line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Огибай мармеладки и не наступай на свой старый след."
          }
        }
      }
    },
    "level.65.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumdrop Orbit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мармеладная орбита"
          }
        }
      }
    },
    "level.66.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frosting is the rail's training appearance. The beam running across it remains dangerous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глазурь — учебное оформление направляющей. Луч поперёк неё остаётся опасным."
          }
        }
      }
    },
    "level.66.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candy rails still carry a lethal beam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По сахарным рельсам всё ещё идёт смертельный луч."
          }
        }
      }
    },
    "level.66.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frosting Rail"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глазурная направляющая"
          }
        }
      }
    },
    "level.67.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The comet was meant to teach timing. Its pretty trail is not a promise of safety."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Комета должна была учить выбору момента. Красивый хвост не обещает безопасности."
          }
        }
      }
    },
    "level.67.tip": {
      "extractionState": "manual",
      "localizations": {
