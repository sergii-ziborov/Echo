    "ability.freeze.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauses systems driven by the field clock. You retain control; this is not universal invulnerability."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостанавливает системы, зависящие от часов поля. Управление сохраняется; общей неуязвимости нет."
          }
        }
      }
    },
    "ability.magnet.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inside a dense cluster of sparks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Среди плотного скопления искр."
          }
        }
      }
    },
