    "mode.deepTime.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore uncharted configurations of the Road in a separate, procedurally generated expedition. Each clear leads deeper; layouts can recur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследуй неразмеченные конфигурации Дороги в отдельной процедурной экспедиции. Каждый пройденный участок ведёт глубже; планировки могут повторяться."
          }
        }
      }
    },
