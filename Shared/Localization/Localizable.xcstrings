    "terms.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO is provided as-is. To the extent permitted by law, the developer is not liable for lost progress, device issues or indirect damages. Your statutory consumer rights remain unchanged."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO предоставляется «как есть». В пределах, допустимых законом, разработчик не несёт ответственности за потерю прогресса, неполадки устройства или косвенный ущерб. Права потребителя, предусмотренные законом, сохраняются."
          }
        }
      }
    },
    "terms.license": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A paid App Store download of ECHO grants a personal, non-transferable license to play the compiled app, including its Apple Watch app, on devices associated with your Apple ID, subject to Apple's Licensed Application End User License Agreement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платная загрузка ECHO из App Store даёт личную непередаваемую лицензию на использование скомпилированного приложения, включая приложение для Apple Watch, на устройствах, связанных с Apple ID, на условиях Лицензионного соглашения Apple с конечным пользователем."
          }
        }
      }
    },
    "terms.limits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may not copy, reverse engineer, redistribute or reuse the app, source, artwork or audio except as allowed by law or a separate written license from the copyright holder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрещается копировать, декомпилировать, распространять или повторно использовать приложение, исходный код, графику и звук, кроме случаев, разрешённых законом или отдельной письменной лицензией правообладателя."
          }
        }
      }
    },
    "terms.progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress, settings and records are stored on this device, and wrist results sync with a paired Apple Watch. Uninstalling the app or using Reset progress permanently removes that local data."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс, настройки и рекорды хранятся на этом устройстве, а результаты с часов синхронизируются с сопряжёнными Apple Watch. Удаление приложения или сброс прогресса безвозвратно стирает эти локальные данные."
          }
        }
      }
    },
    "terms.purchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase is a one-time app download. The current build does not offer subscriptions, consumable items or advertising. Features, maps and balance may change in later updates."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка — разовая загрузка приложения. Текущая версия не содержит подписок, расходуемых покупок и рекламы. Функции, карты и баланс могут меняться в обновлениях."
          }
        }
      }
    },
    "tutorial.1.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag anywhere and the Signal heads for your finger. Lift your finger and it stops."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веди пальцем в любом месте — Сигнал движется к нему. Отпусти палец — и он остановится."
          }
        }
      }
    },
    "tutorial.1.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a smooth route. Your movement will matter again soon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуй плавный маршрут: твоё движение скоро снова пригодится."
          }
        }
      }
    },
    "tutorial.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steer the Signal"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веди Сигнал"
          }
        }
      }
    },
    "tutorial.2.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the echo clock reaches zero, a copy starts replaying the path you just drew."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда отсчёт эха дойдёт до нуля, копия начнёт повторять только что проложенный путь."
          }
        }
      }
    },
    "tutorial.2.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The violet echo is your past, not a collectible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиолетовое эхо — твоё прошлое, его не собирают."
          }
        }
      }
    },
    "tutorial.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your route returns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут возвращается"
          }
        }
      }
    },
    "tutorial.3.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect every spark, then enter the open exit. Avoid crossing the path your echo is about to follow."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери все искры и войди в открытый выход. Не пересекай путь, по которому скоро пройдёт эхо."
          }
        }
      }
    },
    "tutorial.3.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wide loop is safer than a tight knot."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Широкая петля безопаснее тугого узла."
          }
        }
      }
    },
    "tutorial.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave room for yourself"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставь место для себя"
          }
        }
      }
    },
    "tutorial.4.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap the arena to dash. After a crash, Rewind on the Signal lost screen takes you back along your recent route while a charge is left."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двойное касание арены — рывок. После аварии Откат на экране «Сигнал потерян» вернёт тебя по недавнему маршруту, пока остались заряды."
          }
        }
      }
    },
    "tutorial.4.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewind leaves the discarded branch as a temporary ghost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откат оставляет отброшенную ветку временным призраком."
          }
        }
      }
    },
    "tutorial.4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewind a bad turn"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмени неудачный поворот"
          }
        }
      }
    },
