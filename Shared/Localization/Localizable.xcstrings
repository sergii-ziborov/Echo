    "endless.card.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate expedition through procedurally generated arenas. Every clear goes one depth deeper, with more debris, beams and echoes; layouts can recur. A crash you cannot rewind ends the expedition."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельная экспедиция по процедурным аренам. Каждое прохождение ведёт на глубину ниже, где больше обломков, лучей и эхо; планировки могут повторяться. Авария без отката завершает экспедицию."
          }
        }
      }
    },
