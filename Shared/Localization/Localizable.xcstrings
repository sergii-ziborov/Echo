      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The warning line is safe. The bright line is not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Линия предупреждения безопасна. Яркий луч — нет."
