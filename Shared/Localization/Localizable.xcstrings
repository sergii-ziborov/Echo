            "state": "translated",
            "value": "SPEED"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СКОРОСТЬ"
          }
        }
      }
    },
    "region.confection.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RESONANCE"
