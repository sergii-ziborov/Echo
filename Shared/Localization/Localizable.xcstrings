          "stringUnit": {
            "state": "translated",
            "value": "Separate locks keep separate schedules. One successful crossing does not guarantee the return."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разные шлюзы работают по разным расписаниям. Успешный проход не гарантирует возвращения."
          }
        }
