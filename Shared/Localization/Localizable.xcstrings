      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every moving fragment stops"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все движущиеся обломки замирают"
          }
        }
      }
    },
    "ability.freeze.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field Hold extends the duration"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Удержание поля» продлевает действие"
          }
        }
      }
    },
    "ability.freeze.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FREEZE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СТОП"
          }
        }
      }
    },
    "ability.freeze.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание"
          }
        }
      }
