    "wiki.story.break.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the Break, the Keepers’ recovery network began replaying recorded movement. Follow the Fold Road through its damaged stations and carry new state records back to the Lighthouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После Разлада сеть восстановления Хранителей начала повторять записанное движение. Пройди по Дороге складок через повреждённые станции и верни Маяку новые опорные записи."
          }
        }
      }
    },
    "wiki.story.break.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE BREAK"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАЗЛАД"
          }
        }
      }
    },
    "wiki.story.break.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Echoes replay your measured route, not your thoughts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхо повторяет измеренный маршрут, а не твои мысли"
          }
        }
      }
    },
    "wiki.story.break.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time itself did not break — the network did"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сломалось не время, а сеть"
          }
        }
      }
    },
    "wiki.story.break.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the past returns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему прошлое возвращается"
          }
        }
      }
    },
    "wiki.story.chronometer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thirty-six compact rooms in three movements tune the Keeper Chronometer: calibration, regulation and certification. Their rewards support the main campaign; they are not required to finish it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тридцать шесть компактных комнат в трёх частях настраивают Хронометр Хранителей: калибровка, регулировка и сертификация. Их награды помогают основной кампании, но не требуются для её завершения."
          }
        }
      }
    },
    "wiki.story.chronometer.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KEEPER CHRONOMETER"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ХРОНОМЕТР ХРАНИТЕЛЕЙ"
          }
        }
      }
    },
    "wiki.story.chronometer.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewards after 4, 8 and 12 rooms"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Награды за 4, 8 и 12 комнат"
          }
        }
      }
    },
    "wiki.story.chronometer.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch can also steer a run on iPhone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы также могут управлять попыткой на iPhone"
          }
        }
      }
    },
    "wiki.story.chronometer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы"
          }
        }
      }
    },
    "wiki.story.daily.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A daily diagnostic reopens a familiar route with a new spark layout. The daily reward is granted once for the current game day."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневная диагностика открывает знакомый маршрут с новой расстановкой искр. Дневная награда выдаётся один раз за текущий игровой день."
          }
        }
      }
    },
    "wiki.story.daily.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DAILY RIFT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЕЖЕДНЕВНЫЙ РАЗРЫВ"
          }
        }
      }
    },
    "wiki.story.daily.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same place, new sparks"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То же место, новые искры"
          }
        }
      }
    },
    "wiki.story.daily.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pays bonus points once a day"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бонусные очки — раз в день"
          }
        }
      }
    },
    "wiki.story.daily.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A familiar stop, re-laid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знакомый узел, заново"
          }
        }
      }
    },
    "wiki.story.deep.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore uncharted configurations of the Road in a separate, procedurally generated expedition. Each clear leads deeper; layouts can recur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследуй неразмеченные конфигурации Дороги в отдельной процедурной экспедиции. Каждый пройденный участок ведёт глубже; планировки могут повторяться."
          }
        }
      }
    },
    "wiki.story.deep.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BEYOND THE CHARTS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗА ПРЕДЕЛАМИ КАРТ"
          }
        }
      }
    },
    "wiki.story.deep.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A separate expedition, not part of the campaign"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельная экспедиция, не часть кампании"
          }
        }
      }
    },
    "wiki.story.deep.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each depth borrows one region’s sky"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая глубина берёт небо одного из регионов"
          }
        }
      }
    },
    "wiki.story.deep.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубокое время"
          }
        }
      }
    },
    "wiki.story.lighthouse.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse did not command time. It helped distant stations compare their records. When the network failed, the reference went dark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маяк не управлял временем. Он помогал далёким станциям сопоставлять записи. Когда сеть отказала, опорный сигнал погас."
          }
        }
      }
    },
    "wiki.story.lighthouse.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE LIGHTHOUSE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "МАЯК"
          }
        }
      }
    },
    "wiki.story.lighthouse.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Keepers built and ran the network"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранители построили сеть и обслуживали её"
          }
        }
      }
    },
    "wiki.story.lighthouse.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse is where the Road begins — and returns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С Маяка Дорога начинается — и к нему возвращается"
          }
        }
      }
    },
    "wiki.story.lighthouse.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reference, not the clock of the universe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опора, а не часы Вселенной"
          }
        }
      }
    },
    "wiki.story.rewind.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores a recent local state. The discarded route leaves a temporary Paradox Ghost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстанавливает недавнее локальное состояние. Отброшенный путь оставляет временного Парадоксального призрака."
          }
        }
      }
    },
    "wiki.story.rewind.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PARADOX REWIND"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПАРАДОКСАЛЬНЫЙ ОТКАТ"
          }
        }
      }
    },
    "wiki.story.rewind.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay only shows a route; it changes nothing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повтор лишь показывает маршрут и ничего не меняет"
          }
        }
      }
    },
    "wiki.story.rewind.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewind depth depends on research and recorded history"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубина отката зависит от исследований и записанной истории"
          }
        }
      }
    },
    "wiki.story.rewind.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring a cell, not the universe"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление ячейки, а не Вселенной"
          }
        }
      }
    },
    "wiki.story.road.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every map is one node of the Fold Road. Each region lies in a different part of space, so its sky, walls and hazards change with it: gardens adrift, an ice moon, the remains of Cinder, the stations around dying Ashcrown."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая карта — узел Дороги складок. Регионы лежат в разных частях космоса, поэтому вместе с ними меняются небо, стены и угрозы: дрейфующие сады, ледяная луна, остатки Синдера, станции у умирающего Эшкрауна."
          }
        }
      }
    },
    "wiki.story.road.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE FOLD ROAD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ДОРОГА СКЛАДОК"
          }
        }
      }
    },
    "wiki.story.road.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "11 regions · 77 maps"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "11 регионов · 77 карт"
          }
        }
      }
    },
    "wiki.story.road.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each region keeps one sky, getting closer as you cross it"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого региона своё небо — ближе с каждой картой"
          }
        }
      }
    },
    "wiki.story.road.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the sky changes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почему меняется небо"
          }
        }
      }
    },
    "wiki.story.science.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO is science fiction inspired by research on memory in open systems, information, error correction and relativity. The Keepers’ technologies are fictional; their names are not claims that these capabilities exist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO — научная фантастика, вдохновлённая исследованиями памяти открытых систем, информации, коррекции ошибок и теории относительности. Технологии Хранителей вымышлены; их названия не означают, что такие возможности существуют."
          }
        }
      }
    },
    "wiki.story.science.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SCIENCE NOTES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НАУЧНЫЕ ЗАМЕТКИ"
          }
        }
      }
    },
    "wiki.story.science.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is real and what is ours"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что реально, а что придумано"
          }
        }
      }
    },
    "wiki.story.signal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Signal is a steerable carrier in the Keepers’ network, not a lone photon. It picks up sparks — the physical carriers of local state records — and delivers them to the exit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сигнал — управляемый носитель в сети Хранителей, а не одиночный фотон. Он собирает искры — физические носители локальных записей состояния — и доставляет их к выходу."
          }
        }
      }
    },
    "wiki.story.signal.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE SIGNAL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СИГНАЛ"
          }
        }
      }
    },
    "wiki.story.signal.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every spark is needed to open the exit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для выхода нужны все искры"
          }
        }
      }
    },
    "wiki.story.signal.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit is a Fold Gate to the next node"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход — переход Дороги к следующему узлу"
          }
        }
      }
    },
    "wiki.story.signal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The carrier you steer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Носитель, которым ты управляешь"
          }
        }
      }
    },
    "wrist.1.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three sparks begin the chronometer check. Leave room for the path that follows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка хронометра начинается с трёх искр. Оставь место маршруту, который придёт следом."
          }
        }
      }
    },
    "wrist.1.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тик"
          }
        }
      }
    },
    "wrist.1.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three sparks. Your past follows."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три искры. Прошлое идёт следом."
          }
        }
      }
    },
    "wrist.10.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chronometer adds a complication: a sweeping beam and a moving fragment share the room."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У хронометра появляется усложнение: в одной комнате движутся обломок и сканирующий луч."
          }
        }
      }
    },
    "wrist.10.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complication"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усложнение"
          }
        }
      }
    },
    "wrist.10.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sweeping beam and a restless rock."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирующий луч и беспокойный камень."
          }
        }
      }
    },
    "wrist.11.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One timed gate links two halves of the dial. Plan the crossing around both orbiting fragments."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один циклический шлюз соединяет половины циферблата. Учти оба вращающихся обломка перед переходом."
          }
        }
      }
    },
    "wrist.11.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moonphase"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лунная фаза"
          }
        }
      }
    },
    "wrist.11.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gate breathes between two halves."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один шлюз дышит между двумя половинами."
          }
        }
      }
    },
    "wrist.12.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellites turn around a fixed core. Calibration ends here: read the motion without mistaking the center for a safe place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спутники движутся вокруг неподвижного ядра. Здесь калибровка заканчивается: читай движение и не принимай центр за безопасное место."
          }
        }
      }
    },
    "wrist.12.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tourbillon"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Турбийон"
          }
        }
      }
    },
    "wrist.12.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything turns at once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё вращается разом."
          }
        }
      }
    },
    "wrist.13.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hairspring coils through the chamber. Every turn of the route passes close to the one before it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волосок свивается через всю камеру. Каждый виток маршрута проходит рядом с предыдущим."
          }
        }
      }
    },
    "wrist.13.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hairspring"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Волосок"
          }
        }
      }
    },
    "wrist.13.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coil turns back on itself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Виток поворачивает обратно."
          }
        }
      }
    },
    "wrist.14.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like the pallets of an escapement, two gates take turns holding the way. One is always closing when the other opens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как палеты анкерной вилки, два шлюза по очереди держат проход. Когда один открывается, другой уже закрывается."
          }
        }
      }
    },
    "wrist.14.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pallet Fork"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анкерная вилка"
          }
        }
      }
    },
    "wrist.14.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two gates lock and release in turn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два шлюза запирают и отпускают по очереди."
          }
        }
      }
    },
    "wrist.15.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The barrel holds its tension in two rings of fragments. The rim is safe only until your own route returns along it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Барабан держит напряжение в двух кольцах обломков. Ободок безопасен, пока по нему не вернётся твой собственный маршрут."
          }
        }
      }
    },
    "wrist.15.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Barrel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Барабан"
          }
        }
      }
    },
    "wrist.15.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two rings wind around the core."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два кольца вращаются вокруг ядра."
          }
        }
      }
    },
    "wrist.16.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ratchet lets the wheel turn only one way. The crystals expire in order; follow the teeth around the core."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храповик позволяет колесу вращаться только в одну сторону. Кристаллы истекают по порядку — иди по зубцам вокруг ядра."
          }
        }
      }
    },
    "wrist.16.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratchet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храповик"
          }
        }
      }
    },
    "wrist.16.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four crystals, one way round."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре кристалла, один путь по кругу."
          }
        }
      }
    },
    "wrist.17.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three wheels turn in one train. Each hub holds a record; enter between the teeth, not against them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три колеса вращаются в одной передаче. На каждой оси лежит запись: входи между зубцами, а не навстречу им."
          }
        }
      }
    },
    "wrist.17.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gear Train"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Колёсная передача"
          }
        }
      }
    },
    "wrist.17.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect the hubs between the teeth."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забирай оси между зубцами."
          }
        }
      }
    },
    "wrist.18.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The center wheel drives the hands. Here the hand is a beam, and its sweep covers every record in the room."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центральное колесо ведёт стрелки. Здесь стрелка — луч, и её взмах накрывает все записи комнаты."
          }
        }
      }
    },
    "wrist.18.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center Wheel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Центральное колесо"
          }
        }
      }
    },
    "wrist.18.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hand sweeps the dial; cross while it is dark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелка обходит циферблат; проходи, пока она не горит."
          }
        }
      }
    },
    "wrist.19.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fourth wheel counts the seconds. Two beams fire on alternate beats; the lane between them is never quiet for long."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секундное колесо отсчитывает секунды. Два луча стреляют через такт, и проход между ними недолго остаётся тихим."
          }
        }
      }
    },
    "wrist.19.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fourth Wheel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секундное колесо"
          }
        }
      }
    },
    "wrist.19.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two beams keep alternate seconds."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два луча отбивают секунды по очереди."
          }
        }
      }
    },
    "wrist.2.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two pillars divide the dial. Two Echoes can replay the route you draw between them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две опоры делят циферблат. Два эха могут повторить путь, проложенный между ними."
          }
        }
      }
    },
    "wrist.2.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tock"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так"
          }
        }
      }
    },
    "wrist.2.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two pillars, two echoes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две опоры, два эха."
          }
        }
      }
    },
    "wrist.20.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cannon pinion carries the minute hand on a sleeve. A fragment runs its length; the record inside waits for it to pass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минутный триб несёт стрелку на втулке. По ней ходит обломок, и запись внутри ждёт, пока он пройдёт."
          }
        }
      }
    },
    "wrist.20.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannon Pinion"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минутный триб"
          }
        }
      }
    },
    "wrist.20.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A piston rock runs the tube."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камень-поршень ходит по трубе."
          }
        }
      }
    },
    "wrist.21.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rotor winds the chronometer with every movement of the wrist. Two records ride it around a beam in the hub."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ротор заводит хронометр каждым движением запястья. На нём едут две записи — вокруг луча в центре."
          }
        }
      }
    },
    "wrist.21.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ротор"
          }
        }
      }
    },
    "wrist.21.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catch the sparks riding the rotor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лови искры, что едут на роторе."
          }
        }
      }
    },
    "wrist.22.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The power reserve runs down from left to right. Each crystal holds a little longer than the one before it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас хода убывает слева направо. Каждый кристалл держится чуть дольше предыдущего."
          }
        }
      }
    },
    "wrist.22.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Power Reserve"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запас хода"
          }
        }
      }
    },
    "wrist.22.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gauge drains; take it in order."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шкала тает — собирай по порядку."
          }
        }
      }
    },
    "wrist.23.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A chronograph measures intervals. Cross the beam in its pause, then catch the gate on its next opening."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронограф измеряет промежутки. Пересеки луч в паузе, затем поймай шлюз на следующем открытии."
          }
        }
      }
    },
    "wrist.23.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronograph"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронограф"
          }
        }
      }
    },
    "wrist.23.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start, stop, reset: a beam and a gate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старт, стоп, сброс: луч и шлюз."
          }
        }
      }
    },
    "wrist.24.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A flyback resets the hand without stopping the watch. Two fragments run their lanes; the beam in the middle is the reset."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Флайбэк сбрасывает стрелку, не останавливая часы. Два обломка ходят по дорожкам, а луч посередине и есть сброс."
          }
        }
      }
    },
    "wrist.24.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyback"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Флайбэк"
          }
        }
      }
    },
    "wrist.24.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two runs and a reset beam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два хода и луч сброса."
          }
        }
      }
    },
    "wrist.25.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The split-seconds hand stops while its twin runs on. Two beams share one axis and take turns sweeping the quarters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сплит-стрелка останавливается, пока её пара бежит дальше. Два луча делят одну ось и по очереди метут четверти циферблата."
          }
        }
      }
    },
    "wrist.25.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rattrapante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раттрапант"
          }
        }
      }
    },
    "wrist.25.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two hands split the dial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Две стрелки делят циферблат."
          }
        }
      }
    },
    "wrist.26.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tachymeter turns elapsed time into speed. The crystals here reward a route that is fast and short."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тахиметр превращает прошедшее время в скорость. Кристаллы здесь награждают быстрый и короткий маршрут."
          }
        }
      }
    },
    "wrist.26.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tachymeter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тахиметр"
          }
        }
      }
    },
    "wrist.26.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure speed by distance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скорость меряют расстоянием."
          }
        }
      }
    },
    "wrist.27.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A minute repeater chimes the time on demand: hours, quarters, minutes. Three gates open in the same order."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минутный репетир отбивает время по запросу: часы, четверти, минуты. Три шлюза открываются в том же порядке."
          }
        }
      }
    },
    "wrist.27.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute Repeater"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минутный репетир"
          }
        }
      }
    },
    "wrist.27.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three gates chime in turn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три шлюза отбивают по очереди."
          }
        }
      }
    },
    "wrist.28.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A perpetual calendar keeps months of every length. Four wheels turn at four speeds around four records."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечный календарь помнит месяцы любой длины. Четыре колеса вращаются с четырьмя скоростями вокруг четырёх записей."
          }
        }
      }
    },
    "wrist.28.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perpetual Calendar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вечный календарь"
          }
        }
      }
    },
    "wrist.28.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four wheels, four lengths of month."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре колеса, четыре длины месяца."
          }
        }
      }
    },
    "wrist.29.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The equation of time is the gap between the sun's time and the clock's. Two beams mark the two noons; cross between them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уравнение времени — разница между солнечным временем и временем часов. Два луча отмечают два полудня; проходи между ними."
          }
        }
      }
    },
    "wrist.29.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Equation of Time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уравнение времени"
          }
        }
      }
    },
    "wrist.29.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two beams disagree about noon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два луча спорят о полудне."
          }
        }
      }
    },
    "wrist.3.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moving fragment circles the dial like a second hand. Cross after it passes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обломок обходит циферблат, словно секундная стрелка. Пересекай его путь после прохода."
          }
        }
      }
    },
    "wrist.3.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Second Hand"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секундная стрелка"
          }
        }
      }
    },
    "wrist.3.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slow rock sweeps the dial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленный камень обходит циферблат."
          }
        }
      }
    },
    "wrist.30.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidereal time follows the stars, not the sun, and gains a few minutes every day. The records here ride a slow orbit of their own."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёздное время идёт за звёздами, а не за солнцем, и каждый день убегает на несколько минут. Записи здесь движутся по своей медленной орбите."
          }
        }
      }
    },
    "wrist.30.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidereal Time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёздное время"
          }
        }
      }
    },
    "wrist.30.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stars turn a little faster."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звёзды вращаются чуть быстрее."
          }
        }
      }
    },
    "wrist.31.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A remontoire rewinds a small spring at regular intervals so the force never fades. The gates reset on the same schedule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ремонтуар подзаводит маленькую пружину через равные промежутки, чтобы сила не угасала. Шлюзы перезапускаются по тому же расписанию."
          }
        }
      }
    },
    "wrist.31.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remontoire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ремонтуар"
          }
        }
      }
    },
    "wrist.31.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the force to be restored."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождись, пока сила восстановится."
          }
        }
      }
    },
    "wrist.32.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fusee and chain even out the pull of the mainspring. The route unwinds the same way: through two narrow beams, one turn at a time."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фузея с цепью выравнивает тягу заводной пружины. Маршрут разматывается так же: через два узких луча, виток за витком."
          }
        }
      }
    },
    "wrist.32.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fusee"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фузея"
          }
        }
      }
    },
    "wrist.32.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chain unwinds through two beams."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цепь разматывается через два луча."
          }
        }
      }
    },
    "wrist.33.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A detent escapement releases the wheel once per beat and asks for precision in return. The gate and the beam keep the same beat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронометровый спуск отпускает колесо раз в такт и требует взамен точности. Шлюз и луч держат один и тот же такт."
          }
        }
      }
    },
    "wrist.33.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detent Escapement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хронометровый спуск"
          }
        }
      }
    },
    "wrist.33.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One gate, one beam, one moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один шлюз, один луч, один момент."
          }
        }
      }
    },
    "wrist.34.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A constant-force mechanism keeps the drive even from full wind to empty. Four fragments keep the same pace; the room never settles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Механизм постоянной силы держит тягу ровной от полного завода до пустого. Четыре обломка не сбавляют темп, и комната никогда не успокаивается."
          }
        }
      }
    },
    "wrist.34.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Constant Force"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Постоянная сила"
          }
        }
      }
    },
    "wrist.34.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four fragments that never slow down."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре обломка, которые не замедляются."
          }
        }
      }
    },
    "wrist.35.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A grand complication gathers every function in one movement. The beam, the gate and the wheel have to be read together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большое усложнение собирает все функции в одном механизме. Луч, шлюз и колесо нужно читать вместе."
          }
        }
      }
    },
    "wrist.35.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grand Complication"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Большое усложнение"
          }
        }
      }
    },
    "wrist.35.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every mechanism at once."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все механизмы разом."
          }
        }
      }
    },
    "wrist.36.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chronometers were once certified in observatories, tested in every position. This room tests the Signal the same way; pass it, and the chronometer is ready."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда-то хронометры сертифицировали в обсерваториях, проверяя во всех положениях. Эта комната так же испытывает Сигнал; пройди её — и хронометр готов."
          }
        }
      }
    },
    "wrist.36.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observatory Trial"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обсерваторское испытание"
          }
        }
      }
    },
    "wrist.36.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last test: read everything."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последнее испытание: читай всё."
          }
        }
      }
    },
    "wrist.4.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sparks mark the bezel. Rebounding fragments cut across the way to them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искры отмечают ободок. Отскакивающие обломки пересекают пути к ним."
          }
        }
      }
    },
    "wrist.4.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ободок"
          }
        }
      }
    },
    "wrist.4.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparks ride the rim. Rocks ricochet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искры по ободку. Камни рикошетят."
          }
        }
      }
    },
    "wrist.5.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beam cuts across the crown chamber. Wait for a safe interval before crossing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Луч пересекает камеру заводной головки. Выбери безопасный промежуток для прохода."
          }
        }
      }
    },
    "wrist.5.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crown"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заводная головка"
          }
        }
      }
    },
    "wrist.5.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A beam fires across the middle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Луч бьёт поперёк центра."
          }
        }
      }
    },
    "wrist.6.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gate releases the passage in measured intervals. A patrol moves beyond it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шлюз открывает проход через равные промежутки. За ним движется патрульный обломок."
          }
        }
      }
    },
    "wrist.6.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escapement"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спусковой механизм"
          }
        }
      }
    },
    "wrist.6.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slip through the gap between ticks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проскочи в паузу между тактами."
          }
        }
      }
    },
    "wrist.7.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two fragments share a circular track around the center. The room borrows the name of a balance wheel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два обломка делят круговую дорожку вокруг центра. Комната названа в честь часового баланса."
          }
        }
      }
    },
    "wrist.7.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance Wheel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Балансовое колесо"
          }
        }
      }
    },
    "wrist.7.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two weights swing around the core."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два груза кружат вокруг центра."
          }
        }
      }
    },
    "wrist.8.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach the timed crystals early for extra power. When the bonus expires, the records still need collecting."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери кристаллы вовремя ради дополнительного ресурса. После истечения бонуса записи всё равно нужно забрать."
          }
        }
      }
    },
    "wrist.8.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mainspring"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заводная пружина"
          }
        }
      }
    },
    "wrist.8.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold crystals pay a bonus only while they last."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Золотые кристаллы дают бонус, пока не истекут."
          }
        }
      }
    },
    "wrist.9.log": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brittle fragments cross the bearing chamber. Impacts open cracks; watch the fragments, not only their path."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хрупкие обломки пересекают камеру опоры. Удары раскрывают трещины: следи не только за путём, но и за самими обломками."
          }
        }
      }
    },
    "wrist.9.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jewel Bearing"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камневая опора"
          }
        }
      }
    },
    "wrist.9.tip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ice cracks on every wall hit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёд трескается от каждого удара о стену."
          }
        }
      }
    },
    "wrist.act1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calibration"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Калибровка"
          }
        }
      }
    },
    "wrist.act2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Regulation"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулировка"
          }
        }
      }
    },
    "wrist.act3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certification"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сертификация"
          }
        }
      }
    },
    "wristCard.active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ACTIVE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "АКТИВНО"
          }
        }
      }
    },
    "wristCard.install": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install ECHO on your Apple Watch from the Watch app to open the Keeper Chronometer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установи ECHO на Apple Watch через приложение Watch, чтобы открыть Хронометр Хранителей."
          }
        }
      }
    },
    "wristCard.maps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld WRIST ROOMS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КОМНАТ НА ЧАСАХ: %1$lld/%2$lld"
          }
        }
      }
    },
    "wristCard.pair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair an Apple Watch to play thirty-six rooms on your wrist. Every new clear pays %lld research points here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключи Apple Watch, чтобы пройти тридцать шесть комнат на запястье. Каждое новое прохождение даёт здесь %lld очков исследований."
          }
        }
      }
    },
