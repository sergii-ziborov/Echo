          "stringUnit": {
            "state": "translated",
            "value": "The proving ground combines old failures in one room. None of them replaces your own Echo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полигон свёл прежние отказы в одной комнате. Ни один из них не заменяет твоё эхо."
          }
        }
      }
