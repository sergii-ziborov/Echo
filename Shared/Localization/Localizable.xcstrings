    "privacy.changes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If this policy changes, the App Store listing and the public PRIVACY.md file will be updated together."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если политика изменится, страница в App Store и публичный файл PRIVACY.md будут обновлены одновременно."
          }
        }
      }
    },
    "privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seals, research points, skills, research, the last map and sound or haptic preferences are stored on this device with Apple's standard UserDefaults."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаки, очки исследований, способности, исследования, последняя карта и настройки звука и вибрации хранятся на этом устройстве в стандартном хранилище Apple UserDefaults."
          }
        }
      }
    },
    "privacy.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app does not include analytics, advertising, tracking or network calls required to play."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении нет аналитики, рекламы, отслеживания и сетевых запросов, необходимых для игры."
          }
        }
      }
    },
    "privacy.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO does not collect personal data and does not require an account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO не собирает персональные данные и не требует учётной записи."
          }
        }
      }
    },
    "privacy.report": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a bug opens your mail app with a message to the developer that already names the app version, device model and system version. Nothing is sent unless you send it, and the message is used only to answer you and fix the problem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Сообщить об ошибке» открывает почтовое приложение с письмом разработчику, где уже указаны версия приложения, модель устройства и версия системы. Ничего не отправляется без вашего действия, а письмо используется только для ответа и исправления ошибки."
          }
        }
      }
    },
    "privacy.watch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a paired Apple Watch, wrist clears and rewards pass between your iPhone and the watch through Apple's WatchConnectivity, and a run steered from the watch sends its controls the same way. That stays between your own devices."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С сопряжёнными Apple Watch результаты и награды комнат передаются между iPhone и часами через Apple WatchConnectivity, а попытка, которой управляют с часов, передаёт команды тем же способом. Эти данные остаются между вашими устройствами."
          }
        }
      }
    },
