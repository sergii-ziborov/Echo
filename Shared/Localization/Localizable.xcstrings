    "story.ashcrown.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were trying to keep the channels open, not to stop the star from dying."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы пытались сохранить каналы, а не остановить гибель звезды."
