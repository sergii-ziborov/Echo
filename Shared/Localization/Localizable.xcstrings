    "story.final.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first recovery pass is confirmed. The past remains in the Archive; it no longer has to command every next move."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый контур восстановления подтверждён. Прошлое осталось в Архиве; оно больше не обязано командовать каждым следующим движением."
          }
        }
      }
    },
    "story.final.title": {
      "extractionState": "manual",
