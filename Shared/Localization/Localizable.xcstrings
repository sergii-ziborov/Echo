    "watch.tapToFly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag anywhere to steer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веди пальцем в любом месте"
          }
        }
      }
    },
    "wiki.guide.control.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag anywhere and the Signal heads for your finger; lift your finger and it stops and pulses so you can find it. Double-tap the arena to dash. After a crash, Rewind can restore a recent moment while you still have a charge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веди пальцем в любом месте — Сигнал движется к нему; отпусти палец — он остановится и мигнёт, чтобы его было легко найти. Двойное касание арены — рывок. После аварии Откат может вернуть недавний момент, пока остались заряды."
          }
        }
      }
    },
    "wiki.guide.control.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CONTROL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "УПРАВЛЕНИЕ"
          }
        }
      }
    },
    "wiki.guide.control.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No coasting: the Signal stops when you let go"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инерции нет: без пальца Сигнал стоит"
          }
        }
      }
    },
    "wiki.guide.control.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewind is offered after a crash"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откат предлагается после аварии"
          }
        }
      }
    },
    "wiki.guide.control.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to steer · double-tap to dash"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Веди пальцем · двойное касание — рывок"
          }
        }
      }
    },
    "wiki.guide.deepTime.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore uncharted configurations of the Road in a separate, procedurally generated expedition. Each clear leads deeper; layouts can recur. Debris, beams, echoes and new materials ramp up with depth. Rewind still works, but a crash you cannot rewind ends the expedition."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследуй неразмеченные конфигурации Дороги в отдельной процедурной экспедиции. Каждый пройденный участок ведёт глубже; планировки могут повторяться. С глубиной растут обломки, лучи, эхо и новые материалы. Откат работает, но авария без отката завершает экспедицию."
          }
        }
      }
    },
    "wiki.guide.deepTime.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENDLESS MODE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "БЕСКОНЕЧНЫЙ РЕЖИМ"
          }
        }
      }
    },
    "wiki.guide.deepTime.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layouts are checked for connectivity, not for a guaranteed win"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Планировка проверяется на связность, а не на гарантированную победу"
          }
        }
      }
    },
    "wiki.guide.deepTime.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave after a clear and resume from Home"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйди после прохождения — продолжишь с главного экрана"
          }
        }
      }
    },
    "wiki.guide.deepTime.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep Time"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Глубокое время"
          }
        }
      }
    },
    "wiki.guide.echoClock.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number in the beacon at your start counts down to the next echo. At zero a copy starts replaying your route. It is not a time limit; once the map reaches its echo limit, the clock disappears."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Число в маяке на старте отсчитывает время до следующего эха. На нуле копия начинает повторять твой маршрут. Это не лимит времени: когда карта достигнет предела эхо, отсчёт исчезнет."
          }
        }
      }
    },
    "wiki.guide.echoClock.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NEXT ECHO"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СЛЕДУЮЩЕЕ ЭХО"
          }
        }
      }
    },
    "wiki.guide.echoClock.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze pauses this countdown"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание приостанавливает отсчёт"
          }
        }
      }
    },
    "wiki.guide.echoClock.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulse and Shift delay the next echo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импульс и Сдвиг откладывают следующее эхо"
          }
        }
      }
    },
    "wiki.guide.echoClock.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero brings another echo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На нуле появляется новое эхо"
          }
        }
      }
    },
    "wiki.guide.echoes.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An echo replays the route you recorded; it does not predict your next turn, and seals do not erase it. Touching one ends the run unless Phase is active, so every route is also a map you draw for yourself."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхо повторяет записанный маршрут: оно не предсказывает следующий поворот, и знаки маршрута его не стирают. Касание эха прерывает попытку, если не включена Фаза, поэтому каждый маршрут — ещё и карта, которую ты рисуешь для себя."
          }
        }
      }
    },
    "wiki.guide.echoes.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHOES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЭХО"
          }
        }
      }
    },
    "wiki.guide.echoes.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Echoes replay; they never chase you"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхо повторяет, а не преследует"
          }
        }
      }
    },
    "wiki.guide.echoes.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep corridors reusable"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставляй коридоры свободными"
          }
        }
      }
    },
    "wiki.guide.echoes.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recorded route returns"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записанный маршрут возвращается"
          }
        }
      }
    },
    "wiki.guide.goal.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect every spark, including crystals whose bonus has expired. Then enter the open exit. The Echo countdown is not a level time limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери все искры, включая кристаллы с истёкшим бонусом. Затем войди в открытый выход. Отсчёт до эха — не лимит времени уровня."
          }
        }
      }
    },
    "wiki.guide.goal.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GOAL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЦЕЛЬ"
          }
        }
      }
    },
    "wiki.guide.goal.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exit opens after the last spark"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выход открывается после последней искры"
          }
        }
      }
    },
    "wiki.guide.goal.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no time limit on a map"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимита времени на карте нет"
          }
        }
      }
    },
    "wiki.guide.goal.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect every spark, then exit"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери все искры и выйди"
          }
        }
      }
    },
    "wiki.guide.resonance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect another spark within %@ s to raise the chain. The HUD bar shows the time left, and your best chain becomes bonus research points at the finish."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери следующую искру за %@ с, чтобы поднять цепочку. Полоса на экране показывает оставшееся время, а лучшая цепочка на финише превращается в очки исследований."
          }
        }
      }
    },
    "wiki.guide.resonance.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RESONANCE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РЕЗОНАНС"
          }
        }
      }
    },
    "wiki.guide.resonance.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every rank after ×1 adds 10 points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый ранг после ×1 даёт 10 очков"
          }
        }
      }
    },
    "wiki.guide.resonance.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze also pauses the chain window"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание приостанавливает и окно цепочки"
          }
        }
      }
    },
    "wiki.guide.resonance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chain sparks for points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цепочка искр приносит очки"
          }
        }
      }
    },
    "wiki.guide.seals.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear maps and their optional goals to earn Route Seals. Research points buy skills and research; neither is lost when a run is interrupted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проходи карты и их дополнительные цели, чтобы получить знаки маршрута. Очки исследований тратятся на способности и исследования; при прерванной попытке они не теряются."
          }
        }
      }
    },
    "wiki.guide.seals.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ROUTE SEALS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗНАКИ МАРШРУТА"
          }
        }
      }
    },
    "wiki.guide.seals.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Research applies in every region"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исследования действуют во всех регионах"
          }
        }
      }
    },
    "wiki.guide.seals.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Daily Rift pays bonus points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневный разрыв даёт бонусные очки"
          }
        }
      }
    },
    "wiki.guide.seals.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seals and research points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаки и очки исследований"
          }
        }
      }
    },
    "wiki.hazard.beams.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emitter pairs warn, charge, fire and cool down. Sweeping arrays rotate through a marked arc; pulse arrays alternate their timing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пары излучателей предупреждают, заряжаются, стреляют и остывают. Сканирующие установки поворачиваются по отмеченной дуге, импульсные чередуют такты."
          }
        }
      }
    },
    "wiki.hazard.beams.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENERGY"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЭНЕРГИЯ"
          }
        }
      }
    },
    "wiki.hazard.beams.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thin line = warning"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкая линия — предупреждение"
          }
        }
      }
    },
    "wiki.hazard.beams.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solid core = lethal beam"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Яркое ядро — смертельный луч"
          }
        }
      }
    },
    "wiki.hazard.beams.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beams"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучи"
          }
        }
      }
    },
    "wiki.hazard.crystals.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collect every spark, including crystals whose bonus has expired. Take a crystal before its ring empties for bonus Freeze time and points; after that it still has to be collected."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собери все искры, включая кристаллы с истёкшим бонусом. Возьми кристалл, пока кольцо не опустело, — получишь дополнительное Удержание и очки; после этого его всё равно нужно собрать."
          }
        }
      }
    },
    "wiki.hazard.crystals.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TIMED BONUS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "БОНУС С ТАЙМЕРОМ"
          }
        }
      }
    },
    "wiki.hazard.crystals.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Early reward: +%@ s Freeze and +15 points"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ранняя награда: +%@ с Удержания и +15 очков"
          }
        }
      }
    },
    "wiki.hazard.crystals.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze pauses the crystal countdown"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание останавливает отсчёт кристалла"
          }
        }
      }
    },
    "wiki.hazard.crystals.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed crystals"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кристаллы с таймером"
          }
        }
      }
    },
    "wiki.hazard.debris.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every rock is drawn fresh from one of eight materials, and all but Void Alloy fracture after wall impacts. Some maps have a fixed core with satellites; others use ricochets, patrols or paired orbits. Spreading cracks and loose chips mean a rock is about to break."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый камень рисуется заново из одного из восьми материалов; все, кроме сплава «Пустота», раскалываются от ударов о стены. На одних картах есть закреплённое ядро со спутниками, на других — рикошеты, патрули и парные орбиты. Расползающиеся трещины и сколы значат, что камень вот-вот расколется."
          }
        }
      }
    },
    "wiki.hazard.debris.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "KINETIC · MATERIALS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КИНЕТИКА · МАТЕРИАЛЫ"
          }
        }
      }
    },
    "wiki.hazard.debris.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze pauses movement and fracture"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание останавливает движение и разрушение"
          }
        }
      }
    },
    "wiki.hazard.debris.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixed core never moves and resists Repulse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закреплённое ядро не двигается и не отталкивается"
          }
        }
      }
    },
    "wiki.hazard.debris.fact3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Damage shows on the rock itself, without a countdown"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повреждения видны на самом камне, без отсчёта"
          }
        }
      }
    },
    "wiki.hazard.debris.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debris"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обломки"
          }
        }
      }
    },
    "wiki.hazard.gates.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A timed gate alternates between open and solid. Freeze preserves its current state; Phase does not open a closed gate. Red actuator plates mean closed; open cyan frames mark a safe crossing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циклический шлюз чередует открытое и твёрдое состояние. Удержание сохраняет текущее состояние; Фаза не открывает закрытый шлюз. Красные пластины — шлюз закрыт; открытая голубая рамка — можно проходить."
          }
        }
      }
    },
    "wiki.hazard.gates.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SPATIAL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПРОСТРАНСТВО"
          }
        }
      }
    },
    "wiki.hazard.gates.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross while the red bar is absent"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проходи, пока красной перегородки нет"
          }
        }
      }
    },
    "wiki.hazard.gates.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debris rebounds off a closed gate"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обломки отскакивают от закрытого шлюза"
          }
        }
      }
    },
    "wiki.hazard.gates.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed gates"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Циклические шлюзы"
          }
        }
      }
    },
    "wiki.hazard.ghost.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a Rewind, the discarded route replays once as a ghost. It is lethal to touch, and it keeps moving during Freeze."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После Отката отброшенный маршрут один раз проигрывается как призрак. Касаться его смертельно, и он продолжает движение во время Удержания."
          }
        }
      }
    },
    "wiki.hazard.ghost.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AFTER A REWIND"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОСЛЕ ОТКАТА"
          }
        }
      }
    },
    "wiki.hazard.ghost.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It fades when the discarded route ends"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он исчезает, когда отброшенный путь заканчивается"
          }
        }
      }
    },
    "wiki.hazard.ghost.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan the rewind so the ghost is not in your way"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откатывайся так, чтобы призрак не оказался на пути"
          }
        }
      }
    },
    "wiki.hazard.ghost.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paradox Ghost"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Парадоксальный призрак"
          }
        }
      }
    },
    "wiki.hazard.materials.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour tells you how a rock will behave. Hit limits and breakup clocks are game parameters, not universal properties of ice or basalt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По цвету понятно, как поведёт себя камень. Число ударов и время распада — игровые параметры, а не универсальные свойства льда или базальта."
          }
        }
      }
    },
    "wiki.hazard.materials.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEBRIS INDEX"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СПРАВОЧНИК ОБЛОМКОВ"
          }
        }
      }
    },
    "wiki.hazard.materials.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight materials"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восемь материалов"
          }
        }
      }
    },
    "wiki.hazard.mire.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A translucent blue membrane marks a zone that slows the Signal while you stay inside it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полупрозрачная голубая мембрана отмечает зону, которая замедляет Сигнал, пока он внутри."
          }
        }
      }
    },
    "wiki.hazard.mire.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENVIRONMENT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СРЕДА"
          }
        }
      }
    },
    "wiki.hazard.mire.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge counters the drag"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорение компенсирует торможение"
          }
        }
      }
    },
    "wiki.hazard.mire.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debris is not slowed"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обломки не замедляются"
          }
        }
      }
    },
    "wiki.hazard.mire.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mire"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Топь"
          }
        }
      }
    },
    "wiki.hazard.rifts.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entering a calm rift triggers a brief hold. A collapsing rift is lethal while active. A warp rift moves you to another address and flips horizontal steering for a few seconds; a candy rift opens a short training mode."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход в спокойный разрыв включает короткое удержание. Схлопывающийся разрыв смертелен, пока активен. Варп-разрыв переносит по другому адресу и на несколько секунд меняет горизонтальное управление; сахарный — включает короткий учебный режим."
          }
        }
      }
    },
    "wiki.hazard.rifts.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FOLD FAULTS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАЗРЫВЫ ДОРОГИ"
          }
        }
      }
    },
    "wiki.hazard.rifts.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer shifts the echo replay"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переход сдвигает повтор эхо"
          }
        }
      }
    },
    "wiki.hazard.rifts.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candy speeds you up and widens the chain window"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарный режим ускоряет и расширяет окно цепочки"
          }
        }
      }
    },
    "wiki.hazard.rifts.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifts"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрывы"
          }
        }
      }
    },
    "wiki.hazard.scars.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When two Echoes come close enough, they can leave a temporary collision scar. It is not caused by every player crash. Scars fade on their own, and Repulse clears nearby ones."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда два эха сближаются достаточно сильно, они могут оставить временный шрам столкновения. Не каждая гибель игрока создаёт шрам. Шрамы угасают сами, а Отталкивание убирает ближайшие."
          }
        }
      }
    },
    "wiki.hazard.scars.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO COLLISION"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СТОЛКНОВЕНИЕ ЭХО"
          }
        }
      }
    },
    "wiki.hazard.scars.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only echoes meeting each other leave scars"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрамы оставляют только встретившиеся эхо"
          }
        }
      }
    },
    "wiki.hazard.scars.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewind can escape a closing scar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откат помогает уйти от закрывающегося шрама"
          }
        }
      }
    },
    "wiki.hazard.scars.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collision scars"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шрамы столкновений"
          }
        }
      }
    },
    "wiki.hazard.wells.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a local field trap in the Road, not a stellar black hole. Its pull and lethal core are separate game effects. The pull grows as you approach and can bend a route into walls or old echoes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это локальная полевая ловушка Дороги, не звёздная чёрная дыра. Её тяга и опасное ядро — разные игровые эффекты. Тяга растёт по мере приближения и может увести маршрут в стены или старые эхо."
          }
        }
      }
    },
    "wiki.hazard.wells.eyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIELD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПОЛЕ"
          }
        }
      }
    },
    "wiki.hazard.wells.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze pauses the pull"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удержание приостанавливает тягу"
          }
        }
      }
    },
    "wiki.hazard.wells.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surge helps escape the outer pull"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ускорение помогает вырваться из внешней зоны"
          }
        }
      }
    },
