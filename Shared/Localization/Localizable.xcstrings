      }
    },
    "region.debris.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DEBRIS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ОБЛОМКИ"
          }
        }
      }
    },
    "region.debris.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinder survives here as debris and incomplete records. Recover what remains without joining its fragments."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От Синдера здесь остались обломки и неполные записи. Собери уцелевшее, не став частью осколков."
          }
        }
      }
    },
    "region.debris.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is left of Cinder — still moving."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что осталось от Синдера, — и оно движется."
          }
        }
      }
    },
    "region.debris.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hollow is the empty place where Cinder stood on the old charts; the Belt is what remains of it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Полый» — пустое место, где на старых картах был Синдер; пояс — то, что от него осталось."
          }
        }
      }
    },
    "region.debris.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hollow Belt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полый пояс"
          }
        }
      }
    },
    "region.debris.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time does not tear planets apart. The materials, cracks and glowing cores here are simplified for play."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время не разрушает планеты. Материалы, трещины и светящиеся ядра здесь упрощены ради игры."
          }
        }
      }
    },
    "region.debris.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ROCKS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КАМНИ"
          }
        }
      }
    },
    "region.debris.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PATROLS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПАТРУЛИ"
          }
        }
      }
    },
    "region.debris.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MOLTEN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАСПЛАВ"
          }
        }
      }
    },
    "region.drift.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DRIFT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ДРЕЙФ"
          }
        }
      }
    },
    "region.drift.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gardens kept their routines after their keepers left. Their airlocks no longer agree on when to open."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сады сохранили свои распорядки после ухода Хранителей. Их шлюзы больше не согласуют моменты открытия."
          }
        }
      }
    },
    "region.drift.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Greenhouse domes drifting on broken schedules."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оранжереи, дрейфующие по сбитым расписаниям."
          }
        }
      }
    },
    "region.drift.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The orbital modules drift, and the rhythms of their controllers drift apart. The gardens were real greenhouses, not quantum plants."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Орбитальные модули дрейфуют, а ритмы их контроллеров расходятся. Сады были настоящими оранжереями, а не «квантовыми растениями»."
          }
        }
      }
    },
    "region.drift.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drift Gardens"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дрейфующие сады"
          }
        }
      }
    },
    "region.drift.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clocks that drift apart do not put plants in parallel universes. Every gate here simply keeps its own cycle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходящиеся часы не переносят растения в параллельные вселенные. Каждый шлюз здесь просто работает по своему циклу."
          }
        }
      }
    },
    "region.drift.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GATES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ШЛЮЗЫ"
          }
        }
      }
    },
    "region.drift.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BONUSES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "БОНУСЫ"
          }
        }
      }
    },
    "region.drift.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MIRE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ТОПЬ"
          }
        }
      }
    },
    "region.eternity.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ETERNITY"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЕЧНОСТЬ"
          }
        }
      }
    },
    "region.eternity.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Road returns to the Lighthouse. This is the same station, not the same moment: the Signal brings a record it did not have before."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дорога возвращается к Маяку. Это та же станция, но не тот же момент: Сигнал несёт запись, которой здесь прежде не было."
          }
        }
      }
    },
    "region.eternity.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lighthouse again — at a new moment."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снова Маяк — но в новый момент."
          }
        }
      }
    },
    "region.eternity.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Dawn is the final dawn of the Lighthouse's old mode; the first new transmission comes after it. Eternity is the name of the long-term archive, not endless energy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний рассвет — финальный рассвет старого режима Маяка; после него идёт первая новая передача. Вечность — имя архива долговременного хранения, а не бесконечная энергия."
          }
        }
      }
    },
    "region.eternity.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last Dawn"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последний рассвет"
          }
        }
      }
    },
    "region.eternity.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returning to the first station does not close a loop in time. The next pass is a new pass with a new archive, not an undone victory."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращение к первой станции не замыкает петлю времени. Следующий обход — новый проход с новым архивом, а не отменённая победа."
          }
        }
      }
    },
    "region.eternity.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "EVERY HAZARD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВСЁ СРАЗУ"
          }
        }
      }
    },
    "region.eternity.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ARCHIVE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "АРХИВ"
          }
        }
      }
    },
    "region.eternity.trait3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RETURN"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВОЗВРАТ"
          }
        }
      }
    },
    "region.fracture.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FRACTURE"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "РАЗЛОМ"
          }
        }
      }
    },
    "region.fracture.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera's ice is split into narrow passages. A route through them must leave room for its own return."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лёд Тессеры рассечён узкими проходами. Проложенный путь должен оставить место собственному возвращению."
          }
        }
      }
    },
    "region.fracture.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ice moon split into narrow passages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ледяная луна, расколотая на узкие проходы."
          }
        }
      }
    },
    "region.fracture.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera is the ice moon and the mosaic of plots the Keepers cut on it. The shelf is its jutting ice with docks and shafts; Fracture is the breaking of material and channels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тессера — ледяная луна и мозаика участков, на которые Хранители разбили её поверхность. Шельф — выступающий лёд с причалами и шахтами; Разлом — разрушение материала и каналов."
          }
        }
      }
    },
    "region.fracture.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tessera Shelf"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шельф Тессеры"
          }
        }
      }
    },
    "region.fracture.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A crack in ice, a collision scar in the game and a quantum many-body scar are three different things."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трещина во льду, шрам столкновения в игре и квантовый «шрам» многих тел — три разных понятия."
          }
        }
      }
    },
    "region.fracture.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NARROW LANES"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПРОХОДЫ"
          }
        }
      }
    },
    "region.fracture.trait2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SCARS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ШРАМЫ"
          }
        }
      }
    },
    "region.fracture.trait3": {
      "extractionState": "manual",
      "localizations": {
