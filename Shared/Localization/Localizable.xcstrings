    "story.gardens.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The gardens kept watering after the last gardener left. Preserving a routine was not the same as preserving a life."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сады продолжали полив после ухода последнего садовника. Сохранить распорядок — не то же самое, что сохранить жизнь."
          }
        }
      }
    },
    "story.gardens.title": {
