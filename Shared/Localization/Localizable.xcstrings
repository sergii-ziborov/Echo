    "science.correction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error correction protects information that still exists. It cannot restore an arbitrary destroyed past."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коррекция ошибок защищает ещё существующую информацию. Она не восстанавливает произвольно уничтоженное прошлое."
          }
        }
      }
    },
    "science.keepers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Field wells, Phase and the Fold Road are Keeper technology — invented for this game."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полевые ловушки, Фаза и Дорога складок — технологии Хранителей, придуманные для этой игры."
          }
        }
      }
    },
    "science.lensing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravitational lensing bends the paths of light. It does not flip the commands of your hand."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гравитационное линзирование искривляет пути света. Команды руки оно не переворачивает."
          }
        }
      }
    },
    "science.loschmidt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Loschmidt echo measures how well a quantum system can be steered back in a lab. It does not reverse the time of the universe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхо Лошмидта — лабораторная мера того, насколько квантовую систему удаётся вернуть обратно. Оно не обращает время Вселенной."
          }
        }
      }
    },
    "science.mire": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Time thickens in the mire” is an operator’s metaphor: the zone only slows the Signal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Время вязнет в топи» — метафора оператора: зона лишь замедляет Сигнал."
          }
        }
      }
    },
    "science.timecrystal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time crystals are real phases of matter that repeat in time. They do not store seconds or produce free energy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временные кристаллы — реальные фазы вещества, повторяющиеся во времени. Они не хранят секунды и не производят бесплатную энергию."
          }
        }
      }
    },
