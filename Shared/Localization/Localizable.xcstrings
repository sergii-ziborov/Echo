    "about.credits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created by Sergii Ziborov."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автор: Sergii Ziborov."
          }
        }
      }
    },
    "about.data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress is stored locally. Supported Apple Watch results and rewards can sync between paired devices. A bug report is sent only when you choose to send it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогресс хранится локально. Поддерживаемые результаты и награды Apple Watch могут синхронизироваться между сопряжёнными устройствами. Отчёт об ошибке отправляется только по твоему решению."
          }
        }
      }
    },
    "about.features": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld campaign maps in %2$lld regions, the Deep Time expedition, a Daily Rift, and %3$lld rooms on Apple Watch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карт кампании: %1$lld в %2$lld регионах, экспедиция «Глубокое время», Ежедневный разрыв и комнат на Apple Watch: %3$lld."
          }
        }
      }
    },
    "about.game": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO is a route-planning survival puzzle in a world where your own path returns as a hazard. Guide the Signal, collect every spark and reach the exit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO — головоломка о маршрутах и выживании в мире, где пройденный путь возвращается как опасность. Управляй Сигналом, собери все искры и доберись до выхода."
          }
        }
      }
    },
    "about.purchase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One paid download. No ads, subscriptions, in-app purchases or account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка игры. Без рекламы, подписок, встроенных покупок и учётной записи."
          }
        }
      }
    },
    "about.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO is science fiction inspired by research on memory in open systems, information, error correction and relativity. The Keepers’ technologies are fictional; their names are not claims that these capabilities exist."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO — научная фантастика, вдохновлённая исследованиями памяти открытых систем, информации, коррекции ошибок и теории относительности. Технологии Хранителей вымышлены; их названия не означают, что такие возможности существуют."
          }
        }
      }
    },
    "about.version": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %1$@ · Build %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия %1$@ · Сборка %2$@"
          }
        }
      }
    },
    "about.world": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the Break, the Keepers’ recovery network began replaying recorded movement. Follow the Fold Road through its damaged stations and carry new state records back to the Lighthouse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После Разлада сеть восстановления Хранителей начала повторять записанное движение. Пройди по Дороге складок через повреждённые станции и верни Маяку новые опорные записи."
          }
        }
      }
    },
    "archive.back": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to home"
