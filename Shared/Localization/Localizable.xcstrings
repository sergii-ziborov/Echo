    "story.glass.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two images. One source. Neither instrument had the right to call that two homes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Два изображения. Один источник. Ни один прибор не имел права назвать это двумя домами."
          }
        }
      }
    },
