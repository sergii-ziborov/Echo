    "ability.phase.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To slip past echoes or debris in a tight lane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы проскользнуть мимо эха или обломков в тесном проходе."
          }
        }
      }
    },
    "ability.phase.category": {
      "extractionState": "manual",
      "localizations": {
