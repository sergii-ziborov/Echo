{
  "sourceLanguage": "en",
  "strings": {
    "ability.anchor.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When timing windows are too tight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда окна времени слишком узкие."
          }
        }
      }
    },
    "ability.anchor.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FIELD CONTROL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КОНТРОЛЬ ПОЛЯ"
          }
        }
      }
    },
    "ability.anchor.command": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TAP · SLOW THE FIELD"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НАЖМИ · ЗАМЕДЛИ ПОЛЕ"
          }
        }
      }
    },
    "ability.anchor.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlike Freeze, danger still moves — slowly"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В отличие от Удержания, угрозы движутся — медленно"
          }
        }
      }
    },
    "ability.anchor.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local Anchor makes it stronger and longer"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Локальный якорь» усиливает и продлевает эффект"
          }
        }
      }
    },
    "ability.anchor.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SLOW"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗАМЕДЛ."
          }
        }
      }
    },
    "ability.anchor.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Якорь"
          }
        }
      }
    },
    "ability.anchor.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slows the field clock while the Signal keeps its commanded movement speed."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замедляет часы поля, сохраняя скорость управляемого движения Сигнала."
          }
        }
      }
    },
    "ability.blink.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To skip one beam or collision line."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы перескочить луч или линию столкновения."
          }
        }
      }
    },
    "ability.blink.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRANSFER"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ПЕРЕНОС"
          }
        }
      }
    },
    "ability.blink.command": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FACE A DIRECTION · TAP"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВЫБЕРИ НАПРАВЛЕНИЕ · НАЖМИ"
          }
        }
      }
    },
    "ability.blink.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face the destination before tapping"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернись к цели перед нажатием"
          }
        }
      }
    },
    "ability.blink.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blink Drive increases the distance"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Привод скачка» увеличивает дальность"
          }
        }
      }
    },
    "ability.blink.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BLINK"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СКАЧОК"
          }
        }
      }
    },
    "ability.blink.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blink"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачок"
          }
        }
      }
    },
    "ability.blink.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers forward along the current aim or last movement direction. The destination is constrained by solid geometry."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносит вперёд по направлению прицеливания или последнего движения. Конечная точка ограничена твёрдой геометрией."
          }
        }
      }
    },
    "ability.chrono.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before a difficult final route."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед трудным финальным участком."
          }
        }
      }
    },
    "ability.chrono.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ECHO TIMING"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ЗАДЕРЖКА ЭХО"
          }
        }
      }
    },
    "ability.chrono.command": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TAP · DELAY THE NEXT ECHO"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "НАЖМИ · ОТЛОЖИ СЛЕДУЮЩЕЕ ЭХО"
          }
        }
      }
    },
    "ability.chrono.fact1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Combines well with Surge"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хорошо сочетается с Ускорением"
          }
        }
      }
    },
    "ability.chrono.fact2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlocked by Replay Control"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывается «Управлением повтором»"
          }
        }
      }
    },
    "ability.chrono.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SHIFT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СДВИГ"
          }
        }
      }
    },
    "ability.chrono.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сдвиг"
          }
        }
      }
    },
    "ability.chrono.rule": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a longer delay before the next Echo. It does not restore a previous world state."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет более длинную задержку перед следующим эхо. Не восстанавливает прежнее состояние мира."
          }
        }
      }
    },
    "ability.freeze.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When several moving hazards overlap."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда пересекаются несколько движущихся угроз."
          }
        }
      }
    },
    "ability.freeze.category": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CONTROL"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КОНТРОЛЬ"
          }
        }
      }
