      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The emitters keep different phases of one sequence. Find a route through their timing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Излучатели держат разные фазы одной последовательности. Найди путь между их включениями."
          }
        }
