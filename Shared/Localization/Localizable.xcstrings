      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Echoes, rocks, mire. Leave a gap anyway."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эхо, камни, топь. Всё равно оставь просвет."
