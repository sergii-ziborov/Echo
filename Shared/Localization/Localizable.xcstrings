    "story.break.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The failed controller treated the last confirmed state as an instruction to restore it. Every correction demanded another correction."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отказавший контроллер принял последнее подтверждённое состояние за команду к восстановлению. Каждое исправление требовало нового исправления."
          }
        }
      }
    },
    "story.break.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Break"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разлад"
          }
        }
      }
    },
    "story.cinder.author": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archive entry"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись Архива"
          }
        }
      }
    },
    "story.cinder.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinder survived in the Archive as a world. On the Road, only its fragments answered."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Архиве Синдер сохранился как мир. На Дороге отвечали только его обломки."
          }
        }
      }
    },
    "story.cinder.title": {
      "extractionState": "manual",
