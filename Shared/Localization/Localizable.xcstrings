    "records.watch.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear rooms on Apple Watch to build this rating. Clears sync to this iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проходи комнаты на Apple Watch, чтобы набрать этот рейтинг. Прохождения синхронизируются с этим iPhone."
          }
        }
      }
    },
    "records.watch.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every cleared room is worth 100, and every second of the best time under par adds 10."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая пройденная комната — 100, и каждая секунда лучшего времени быстрее нормы — ещё 10."
          }
        }
      }
    },
    "records.watch.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld ROOMS · %3$lld/%4$lld REWARDS"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "КОМНАТ: %1$lld/%2$lld · НАГРАД: %3$lld/%4$lld"
          }
        }
      }
    },
    "region.confection.act": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CONFECTION"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СЛАСТИ"
          }
        }
      }
    },
    "region.confection.arrival": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was a children's training profile. Its bright scenery survived the Break; its safety limits did not."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это был детский учебный профиль. Яркое оформление пережило Разлад; ограничения безопасности — нет."
          }
        }
      }
    },
    "region.confection.blurb": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A children's training mode without its limits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Детский учебный режим без ограничений."
          }
        }
      }
    },
    "region.confection.meaning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A confection is a sweet thing made by hand. This timeline is a saved training mode, named by the Keepers' children and their teachers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сласти — сделанное руками сладкое украшение. Эта линия — сохранённый учебный режим, названный детьми Хранителей и их учителями."
          }
        }
      }
    },
    "region.confection.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candy Timeline"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарная линия"
          }
        }
      }
    },
    "region.confection.science": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The candy mode makes you faster and widens the collection chain for a while. It is not another universe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сахарный режим на время ускоряет и расширяет окно цепочки сбора. Это не другая Вселенная."
          }
        }
      }
    },
    "region.confection.trait1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CANDY"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "СЛАСТИ"
          }
        }
      }
    },
    "region.confection.trait2": {
      "extractionState": "manual",
