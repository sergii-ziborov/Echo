        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно подавляет смертельные контакты. Твёрдые стены и закрытые шлюзы всё ещё ограничивают движение."
          }
        }
      }
    },
    "ability.prism.best": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While crossing an active beam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
